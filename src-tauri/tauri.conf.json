{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nova",
  "version": "0.1.0",
  "identifier": "com.nova.assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NOVA",
        "width": 900,
        "height": 650,
        "minWidth": 640,
        "minHeight": 480,
        "visible": false,
        "focus": false,
        "decorations": false
      },
      {
        "label": "assistant",
        "title": "NOVA Assistant",
        "url": "index.html",
        "width": 420,
        "height": 144,
        "visible": false,
        "focus": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "backgroundColor": "#00000000",
        "shadow": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/wake-word/*",
      "resources/speech/**/*",
      "resources/vad/*"
    ]
  }
}
