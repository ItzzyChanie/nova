{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nova",
  "version": "1.0.1",
  "identifier": "com.nova.assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NOVA",
        "width": 1120,
        "height": 820,
        "minWidth": 900,
        "minHeight": 680,
        "visible": false,
        "focus": false,
        "decorations": false
      },
      {
        "label": "assistant",
        "title": "NOVA Assistant",
        "url": "assistant.html",
        "width": 520,
        "height": 180,
        "visible": false,
        "focus": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "backgroundColor": "#00000000",
        "shadow": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1421; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/wake-word/*",
      "resources/speech/**/*",
      "resources/vad/*"
    ],
    "shortDescription": "Local Windows development assistant"
  }
}
