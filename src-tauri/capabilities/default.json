{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-show-assistant",
    "allow-get-startup-settings",
    "allow-save-project-profile",
    "allow-delete-project-profile",
    "allow-get-project-status",
    "allow-get-workflows",
    "allow-save-workflow",
    "allow-delete-workflow",
    "allow-execute-registered-tool",
    "allow-get-privacy-settings",
    "allow-set-privacy-setting",
    "allow-clear-local-data",
    "allow-get-runtime-info",

    "allow-set-nova-enabled",
    "allow-set-skill-preference",
    "allow-route-tool-request",
    "allow-execute-confirmed-application-tool",
    "allow-get-command-history",
    "allow-clear-command-history-day",
    "allow-execute-confirmed-file-tool",
    "allow-execute-confirmed-system-tool",
    "allow-get-known-projects",
    "allow-add-known-project",
    "allow-list-microphone-devices",
    "allow-set-selected-microphone",
    "allow-start-microphone-test",
    "allow-get-microphone-test-state",
    "allow-stop-microphone-test",
    "allow-set-wake-sensitivity",
    "allow-set-assistant-paused",
    "allow-get-wake-engine-status",
    "allow-set-speech-model-path",
    "allow-set-voice-reply",
    "allow-get-speech-engine-info",
    "allow-get-local-model-info",
    "allow-interpret-natural-language",
    "core:window:allow-is-maximized",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ]
}
